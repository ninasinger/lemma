{
  "name": "lemma",
  "version": "1.0.0",
  "private": true,
  "description": "Bite-size lessons and spaced-repetition reviews for the math behind machine learning: matrices, PCA, SVD, regularization and dropout.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "node server.js",
    "seed": "node --env-file=.env scripts/seed.js",
    "test": "node --test",
    "verify:py": ".venv/bin/python scripts/verify_numpy.py",
    "icons": "python3 scripts/make_icons.py"
  },
  "dependencies": {
    "@netlify/blobs": "11.1.3"
  }
}
